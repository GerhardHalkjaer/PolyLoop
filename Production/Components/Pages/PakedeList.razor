@page "/PakedeList"
@using Services
@using Entities
@inject Service myServ
@inject IBIZ Biz
@rendermode InteractiveServer

@if (units == null || units.Count == 0)
{
    <p>No units found.</p>
}
else
{
    <div class="mb-3 d-flex">
        <button class="btn btn-primary me-2" @onclick="ShowNotShipped">På lager</button>
        <button class="btn btn-success me-2" @onclick="ShowShipped">Sent</button>
        <button class="btn btn-primary ms-auto" @onclick="ProcessSelected">Process Selected</button>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>MaterialeType</th> 
                <th>SpecificType</th>
                <th>Embllage</th>
                <th>Vægt</th>
                <th>Dato</th>
                <th>Billede</th>
                <th>Send</th>
                
            </tr>
        </thead>
        <tbody>
            @foreach (var unit in FilteredUnits)
            {
                <tr>
                    <td>@unit.Id</td>
                    <td>@unit.SpecificType.MatType.Name</td> 
                    <td>@unit.SpecificType.Name</td> 
                    <td>@unit.Packaging.Name</td>
                    <td>@unit.weight</td>
                    <td>@unit.ProcessedDate.ToString("yyyy-MM-dd")</td>
                    @{
                        string imgPath = Path.Combine($@"/localimage", unit.ImagePath);
                    }
                    <td><img src="@imgPath" alt="Image of the plastic" @onclick="() => ShowImage(imgPath)" class="imgThumbnail" /></td>
                    @* <td><img src="@Path.Combine($@"{Environment.GetEnvironmentVariable("OneDrive")}\PolyLoopImg", unit.ImagePath)" alt="Image of the plastic"/></td> *@

                    <td>
                        <input type="checkbox" @bind="SelectedItems[unit.Id]" />
                    </td>

                </tr>
            }
        </tbody>
    </table>
}

@if (SelectedImage != null)
{
    <div class="overlay" @onclick="CloseImage">
        <div class="modal">
            <img src="@SelectedImage" class="modal-image" />
            
            <button class="close-btn"
                    @onclick:stopPropagation="true"
                    @onclick="CloseImage">
                ✖
            </button>
        </div>
    </div>
}


@code {

    private List<PackagedUnit> units;

    private bool showShipped = false;

    private IEnumerable<PackagedUnit> FilteredUnits =>
        showShipped ? units.Where(u => u.Shipped) : units.Where(u => !u.Shipped);

    private void ShowShipped() => showShipped = true;
    private void ShowNotShipped() => showShipped = false;

    private Dictionary<int, bool> SelectedItems = new();




    protected override async Task OnInitializedAsync()
    {
        units = await myServ.GetAllPackagedUnitAsync();
        // You can also filter or sort the units here if needed

        // Initialize dictionary with false for all
        SelectedItems = units.ToDictionary(p => p.Id, p => false);
    }

    private string? SelectedImage;

    private void ShowImage(string img)
    {
        SelectedImage = img;

    }

    private void CloseImage()
    {
        SelectedImage = null;
    }


    private void ProcessSelected()
    {
        List<PackagedUnit> selectedProducts = FilteredUnits
            .Where(p => SelectedItems[p.Id])
            .ToList();

        //TODO update DB Shipped to true


        foreach (PackagedUnit unit  in selectedProducts)
        {
            unit.Shipped = !unit.Shipped;

            myServ.PostPackagedUnitShippingUpdateAsync(unit);
        }


    }

}
