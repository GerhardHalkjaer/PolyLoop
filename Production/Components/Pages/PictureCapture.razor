@page "/PictureCapture"
@using Services
@using Entities
@inject Service myServ
@inject IBIZ Biz
@using Production.Model
@rendermode InteractiveServer
@inject IJSRuntime JS
@using System.Diagnostics
@using Microsoft.AspNetCore.Components.Forms


<div class="Camera-container">

    
        <div>
            <video id="rearCamera" autoplay playsinline muted crossorigin="anonymous"
               style="display:@(camerasRunning ? "block" : "none")" class="video-container"></video>
        </div>

    <div class="camera-controls mb-3" style="display:@(camerasRunning ? "block" : "none")">
            <button class="btn btn-danger camSnap" @onclick="CaptureImg">📸 Capture</button>
    </div>
    
    <div style="display:@(_pictureTaken ? "block" : "none")">

        <label form="weightlabel">Vægt</label>
        <input id="unitValue"
            type="number"
            @bind-value="unitValue"
            @bind-value:event="oninput"
            class="form-control"
            @onkeydown="HandleKeyDown" />

    </div>
</div>

@code {

    [Inject] NavigationManager Nav { get; set; } // Inject navigation service

    private bool _started = false;
    private string oneDrivePath = Environment.GetEnvironmentVariable("OneDrive");
    private int unitValue;
    private bool camerasRunning = false;
    private bool _pictureTaken = false;

    /// <summary>
    /// This method is called after the component has rendered.
    /// </summary>
    /// <param name="firstRender"></param>
    /// <returns></returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_started)
        {
            _started = true;
            await InitializeProcess();
        }

    }

    private async Task InitializeProcess()
    {
        await StartCameras();
    }

    /// <summary>
    /// Handles the key down event for the input field and if enter is pressed act on it.
    /// </summary>
    /// <param name="e"></param>
    /// <returns></returns>
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SubmitValueAsync();
        }
    }

    /// <summary>
    /// Submits the value entered in the input field and subtract the packagning weight from it and captures images from both cameras.
    /// </summary>
    /// <returns></returns>
    private async Task SubmitValueAsync()
    {

        //TODO
        Biz.packagedUnit.weight = unitValue - Biz.packagedUnit.Packaging.PackagingWeight;

        //  Nav.NavigateTo("/PrintLabel");    TODO: TURN ON AGAIN-------------------------------------------------------------------------------------------------
    }


    /// <summary>
    /// sets the processed date of the packaged unit to now.
    /// </summary>
    /// <returns></returns>
    private async Task SetProcessDate()
    {
        Biz.packagedUnit.ProcessedDate = DateTime.Now;
    }

    /// <summary>
    /// get the id's of the cameras
    /// </summary>
    /// <returns></returns>
    // private async Task<List<string>> GetVidpids()
    // {
    //     List<string> listOfVidIDs = await JS.InvokeAsync<List<string>>("sendVidPids");

    //     //TODO: change use cookies to save the id's of the cameras and their names and what they are used for.

    //     return listOfVidIDs;
    // }

    /// <summary>
    /// Initializes and starts both cameras by invoking the JavaScript function.
    /// </summary>
    /// <returns></returns>
    private async Task StartCameras()
    {
        try
        {
            var result = await JS.InvokeAsync<CameraStartResult>(
                "blazorCameraSystem.startRearCamera", "rearCamera");
            if (result.Success)
            {
                camerasRunning = true;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {

            Debug.WriteLine($"Error starting camera: {ex.Message}");

        }


        //result can be used to see if cameras where started
    }

    /// <summary>
    /// Captures an image from the specified camera using javascript and sends it to the server.
    /// </summary>
    /// <param name="camIndex">The index of the camera (0 for first camera, 1 for second camera).</param>
    /// <returns></returns>
    private async Task CaptureImg()
    {

        try
        {
            var result = await JS.InvokeAsync<CaptureResult>(
                "blazorCameraSystem.captureImage", "rearCamera", 1.0);

            await SetProcessDate();

            await SendToServer(0, result.ImageData);

            await StopCameras();

            _pictureTaken = true;

            //return result.ImageData;
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"Error capturing image: {ex.Message}");
        }
    }

    private async Task StopCameras()
    {
        await JS.InvokeVoidAsync("blazorCameraSystem.stopCameras");
        camerasRunning = false;
        StateHasChanged();

    }


    /// <summary>
    /// used to send convert a base64 string to an image and save it on onedrive
    /// </summary>
    /// <param name="camIndex">the ID of the camera</param>
    /// <param name="base64Image">a base64 string reprencenting the img</param>
    /// <returns></returns>
    private async Task SendToServer(int camIndex, string base64Image)
    {
        var imageData = new WebcamImage { CameraIndex = camIndex, Base64Data = base64Image };
        // await Http.PostAsJsonAsync("api/webcam/upload", imageData);


        // Remove the data URL prefix (if it exists)
        string base64 = imageData.Base64Data;
        if (base64.StartsWith("data:image"))
        {
            var commaIndex = base64.IndexOf(',');
            base64 = base64.Substring(commaIndex + 1);
        }

        // Decode the base64 string into bytes
        byte[] imageBytes = Convert.FromBase64String(base64);

        // Save the image to a file
        await SavePackage();

        // File name
        string fileName = $"ID_{Biz.packagedUnit.Id}_image_{DateTime.Now.Ticks}.png";

        // put filename in Biz.packagedUnit
        Biz.packagedUnit.ImagePath = fileName;
        await myServ.PostPackagedUnitUpdateAsync(Biz.packagedUnit);

        // Specify a path to save the image
        string filePath = Path.Combine($@"{oneDrivePath}\PolyLoopImg", fileName);

        // Write the bytes to a file
        await File.WriteAllBytesAsync(filePath, imageBytes);
        Console.WriteLine($"Image saved to: {filePath}");
    }

    /// <summary>
    /// Saves the packaged unit to the Database via Service and updates its ID that is returned from the database.
    /// </summary>
    /// <returns></returns>
    /// <exception cref="Exception"></exception>
    public async Task SavePackage()
    {
        Biz.packagedUnit.UserPacking = 1;
        Biz.packagedUnit.Id = await myServ.PostPackagedUnitAsync(Biz.packagedUnit) ?? throw new Exception("Failed to get ID from API.");
    }


    /// <summary>
    /// used to request camera access from the browser
    /// else the browser will not allow the camera to be accessed the 2nd camera
    /// </summary>
    /// <returns></returns>
    private async Task RequestCameras()
    {
        await JS.InvokeVoidAsync("requestCameras");
    }



    // Helper classes for JS interop
    public class CameraStartResult
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public string? Error { get; set; }
    }

    public class CaptureResult
    {
        public bool Success { get; set; }
        public string ImageData { get; set; } = "";
        public string VideoId { get; set; } = "";
        public int Width { get; set; }
        public int Height { get; set; }
        public string? Error { get; set; }
    }

}




